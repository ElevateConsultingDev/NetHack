#!/bin/sh
# NetHack with the Claude helper, in a browser. Arguments go to nethack, e.g. ./web -u Dave
cd "$(dirname "$0")" || exit 1
if [ ! -x playground/nethack ]; then
    sh sys/unix/setup.sh sys/unix/hints/macosx10.14 && make WANT_SOURCE_INSTALL=1 all || exit 1
fi
(sleep 1; open "http://127.0.0.1:${NH_WEB_PORT:-8220}") &
exec uv run -q --with pyte python3 web.py "$@"
